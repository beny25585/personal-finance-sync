{
  "name": "personal-finance-sync-mobile",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --build",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "android:sync": "npm run build && cap sync android",
    "apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "test": "node --test tests/*.test.ts",
    "test:browser": "node --test tests/*.browser.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@lucide/vue": "1.66.0",
    "vue": "3.5.44",
    "vue-i18n": "11.4.17",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
