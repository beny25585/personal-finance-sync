{
  "name": "personal-finance-sync-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --build",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "android:sync": "npm run build && cap sync android",
    "apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "vue": "3.5.44",
    "@capacitor/core": "8.6.0",
    "@capacitor/android": "8.6.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11",
    "@capacitor/cli": "8.6.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
